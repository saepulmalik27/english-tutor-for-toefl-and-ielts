datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// The single Learner (Cloudflare Access is the only gate). Progress, bands and the streak are all
// computed from practice data, so nothing else is stored here.
model User {
  id          String   @id @default(uuid())
  isOnboarded Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Latest x-ratelimit-* headers per AI source ("chat", "fallback", "stt"); shown on the dashboard.
model AiQuota {
  source    String   @id
  headers   Json
  updatedAt DateTime @updatedAt
}

// Question-bank content (PRD v2): one Passage/Question pair for every content kind.
enum ContentKind {
  reading_s1
  reading_s2
  reading_s3
  writing_t1
  writing_t2
  speaking_p1
  speaking_p2
  speaking_p3
  drill        // review drill for one Error Pattern (Question.patternId)
}

enum ContentStatus {
  active
  retired
}

model Passage {
  id        String        @id @default(uuid())
  kind      ContentKind
  status    ContentStatus @default(active)
  title     String
  body      String
  wordCount Int
  source    String        // "enwiki" for crawled text, "generated" for LLM-written text
  sourceId  String?       // page id at the source; null for generated text
  sourceUrl String?
  license   String?       // shown with the passage (CC BY-SA 4.0 for Wikipedia)
  generationAttempts Int  @default(0) // failed question-set attempts; retired after 3
  createdAt DateTime      @default(now())

  questions Question[]

  @@unique([source, sourceId])
  @@index([kind, status])
}

model Question {
  id          String        @id @default(uuid())
  passageId   String?       // null for stand-alone prompts (Writing tasks, Speaking sets)
  kind        ContentKind
  type        String        // e.g. tfng, sentence_completion, matching_headings
  instructions String?      // IELTS rubric shared by the question's group
  position    Int           @default(0)
  prompt      String
  options     Json?
  answer      String?
  explanation String?
  status      ContentStatus @default(active)
  patternId   String?       // drills only: the Error Pattern this drill trains
  createdAt   DateTime      @default(now())

  passage     Passage?      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  answers     Answer[]
  speakingAttempts SpeakingAttempt[]
  writingAttempts  WritingAttempt[]

  @@index([kind, status])
  @@index([patternId])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  given      String
  correct    Boolean
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// Error Pattern spaced repetition (PRD v2): one FSRS-6 card per taxonomy pattern (lib/patterns).
model PatternCard {
  patternId String   @id
  card      Json     // ts-fsrs v6 card state
  dueAt     DateTime
  updatedAt DateTime @updatedAt

  @@index([dueAt])
}

// Every time a pattern shows up in practice; the Weakness Profile counts these over 30 days.
model PatternEvent {
  id        String   @id @default(uuid())
  patternId String   // taxonomy ID, or "other" with the LLM's label in note
  source    String   // reading | speaking | writing | drill
  note      String?
  refId     String?  // e.g. the Question or Answer that produced it
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([patternId])
}

// One recorded Speaking answer. The audio itself is never stored (PRD v2): only what Whisper and the
// scorer produced from it.
model SpeakingAttempt {
  id         String   @id @default(uuid())
  questionId String
  transcript String
  words      Json     // Whisper word timestamps
  metrics    Json     // fluency metrics computed in code
  scores     Json     // { FC, LR, GRA: { band, reason } }
  feedback   Json     // Indonesian Feedback
  band       Float    // overall midpoint; shown as a ±1 range
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// One Writing Task 1 or 2 submission with its scores and Indonesian Feedback (replaces the v1 Journal).
model WritingAttempt {
  id         String   @id @default(uuid())
  questionId String
  text       String
  wordCount  Int
  scores     Json     // { TA|TR, CC, LR, GRA: { band, reason } }
  feedback   Json     // Indonesian Feedback + Error Pattern tags
  band       Float    // task band midpoint; shown as a ±1 range
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// One daily Practice Session per WIB day: the composed plan, the current block, and when it was finished.
// The streak counts days with a completed session.
model PracticeSession {
  id          String    @id @default(uuid())
  day         String    @unique // "YYYY-MM-DD" in WIB
  plan        Json      // { blocks: [{ type, minutes }], reason }
  step        Int       @default(0)
  results     Json      @default("{}") // per-block notes for the summary
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}
