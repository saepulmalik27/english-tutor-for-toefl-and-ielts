datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  streak            Int                @default(0)
  lastActive        DateTime?
  currentIeltsBand  Float              @default(4.0) // Estimated IELTS band (4.0 to 9.0)
  currentToeflScore Int                @default(30)  // Estimated TOEFL score (30 to 120)
  targetIeltsBand   Float              @default(6.5) // Target IELTS score
  targetToeflScore  Int                @default(80)  // Target TOEFL score
  isOnboarded       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  
  // Relations
  journals          Journal[]
  dailyMetrics      DailyMetric[]
  
  // Generated content relations
  generatedLessons  GeneratedLesson[]
  memory            UserMemory?
}

model DailyMetric {
  id          String   @id @default(uuid())
  userId      String
  date        String   // YYYY-MM-DD format for easy daily snapshots
  ieltsBand   Float
  toeflScore  Int
  readingScore Float    // Component reading metric
  writingScore Float    // Component writing metric
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Journal {
  id          String   @id @default(uuid())
  userId      String
  prompt      String   // Writing prompt in English & Indonesian
  userText    String   // User's submitted English text
  feedback    String   // Markdown feedback from the AI/Tutor in Indonesian
  score       Int      // Writing score (0-100)
  ieltsBand   Float    // Estimated IELTS Writing Band (e.g., 5.5)
  toeflScore  Int      // Estimated TOEFL Writing Score (e.g., 20)
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String   @id @default(uuid())
  title       String   // Title in Indonesian (e.g., "Memahami Present Continuous Tense")
  category    String   // "Grammar", "Vocabulary", "Reading Tips"
  difficulty  String   // "Basic", "Intermediate", "Advanced"
  content     String   // Markdown content of the lesson in Indonesian
  summary     String   // Short summary
  createdAt   DateTime @default(now())
}

model UserMemory {
  id               String   @id @default(uuid())
  userId           String   @unique
  weakGrammarRules String
  weakVocabWords   String
  interestTopics   String
  lastCompressedAt DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedLesson {
  id          String   @id @default(uuid())
  userId      String
  title       String
  category    String
  content     String
  summary     String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Latest x-ratelimit-* headers per AI source ("chat", "fallback", "stt"); shown on the dashboard.
model AiQuota {
  source    String   @id
  headers   Json
  updatedAt DateTime @updatedAt
}

// Question-bank content (PRD v2): one Passage/Question pair for every content kind.
enum ContentKind {
  reading_s1
  reading_s2
  reading_s3
  writing_t1
  writing_t2
  speaking_p1
  speaking_p2
  speaking_p3
}

enum ContentStatus {
  active
  retired
}

model Passage {
  id        String        @id @default(uuid())
  kind      ContentKind
  status    ContentStatus @default(active)
  title     String
  body      String
  wordCount Int
  source    String        // "enwiki" for crawled text, "generated" for LLM-written text
  sourceId  String?       // page id at the source; null for generated text
  sourceUrl String?
  license   String?       // shown with the passage (CC BY-SA 4.0 for Wikipedia)
  createdAt DateTime      @default(now())

  questions Question[]

  @@unique([source, sourceId])
  @@index([kind, status])
}

model Question {
  id          String        @id @default(uuid())
  passageId   String?       // null for stand-alone prompts (Writing tasks, Speaking sets)
  kind        ContentKind
  type        String        // e.g. tfng, completion, matching_headings
  prompt      String
  options     Json?
  answer      String?
  explanation String?
  status      ContentStatus @default(active)
  createdAt   DateTime      @default(now())

  passage     Passage?      @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([kind, status])
}
